# Copie para .env e preencha. NUNCA versione o .env real.

# Token do bot (BotFather). Usado tambem para validar o initData do Mini App.
BOT_TOKEN=

# @username do bot, sem o @. Usado no deep-link do Mini App.
BOT_USERNAME=

# Short name do Mini App configurado no BotFather (/newapp).
MINI_APP_SHORT_NAME=app

# Id numerico do canal dos clientes (ex.: -1001234567890).
# E o unico chat para onde tips podem ser enviadas. Nada de sistema vai para ca.
CHANNEL_ID=

# Ids do Telegram autorizados a publicar tips pelo bot (/tip), separados por virgula.
# Para descobrir o seu: mande qualquer mensagem ao bot em conversa privada — ele
# responde com o seu id. Depois cole aqui.
ADMIN_IDS=

# URL publica onde este servidor esta hospedado (https). Sem barra no fim.
# O Mini App e servido a partir daqui.
PUBLIC_URL=http://localhost:3000

# Porta do servidor local.
PORT=3000

# Janela maxima (segundos) de validade do initData do Telegram, para barrar replay.
INITDATA_MAX_AGE_SECONDS=86400

# Caminho do arquivo de armazenamento local (JSON). Trocavel por um banco real.
STORE_FILE=./data/store.json
